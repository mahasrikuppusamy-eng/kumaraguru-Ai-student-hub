{
  "name": "Kumaraguru AI Student Hub",
  "short_name": "KCT AI Hub",
  "description": "AI-Powered Student Engagement, Events, Matchmaking & Smart Campus Portal for Kumaraguru College.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#020617",
