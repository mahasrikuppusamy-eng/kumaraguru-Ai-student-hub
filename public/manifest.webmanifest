      "url": "./#hackathons",
      "icons": [{ "src": "./icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "AI Matchmaker",
      "short_name": "Matchmaker",
      "description": "Find AI teammates for projects",
      "url": "./#matches",
      "icons": [{ "src": "./icon.svg", "sizes": "192x192" }]
    }
  ]
}
